+        },
+        "model_config": model.config.to_dict(),
+        "base_g": model.hg_g,
+        "nll": nll["mean"],
+        "nll_standard_error": nll["standard_error"],
+        "forward_kl_estimate": kl["mean"],
+        "forward_kl_standard_error": kl["standard_error"],
